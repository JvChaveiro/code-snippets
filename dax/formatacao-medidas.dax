VAR _currency = "R$ "
VAR _value = [Quantidade]
VAR _formating = 
SWITCH(
    TRUE(),
    ABS( _value) >= 1E9, FORMAT( _value, "#,,,.00 Bi;#,,,.00 Bi;0", "pt-br"),
    ABS( _value) >= 1E6, FORMAT( _value, "#,,.00 Mi;#,,.00 Mi;0", "pt-br"),
    ABS( _value) >= 1E3, FORMAT( _value, "#,.0 mil;#,.0 mil;0", "pt-br"),
    FORMAT( _value, "#;#;0")
)
VAR _formated = _currency & """" & _formating & """"
RETURN _formated